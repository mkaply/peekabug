{
  "manifest_version": 3,
  "name": "Peekabug",
  "version": "1.0",
  "description": "Shows the real titles and activity of secure Bugzilla bugs and Phabricator revisions in Gmail, kept out of Gmail's page.",
  "browser_specific_settings": {
    "gecko": {
      "id": "peekabug@kaply.com",
      "update_url": "https://raw.githubusercontent.com/mkaply/peekabug/main/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://bugzilla.mozilla.org/*",
    "https://phabricator.services.mozilla.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "view.html"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html"
  }
}
